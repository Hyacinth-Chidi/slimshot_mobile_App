<?xml version="1.0" encoding="utf-8"?>
<!-- One size, 4 x 2. It redraws hourly — so "today" turns to "yesterday" —
     and whenever the app sends a new last edit; nothing else wakes it. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_continue_editing_description"
    android:initialLayout="@layout/widget_continue_editing"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:previewImage="@drawable/widget_preview"
    android:previewLayout="@layout/widget_continue_editing_preview"
    android:resizeMode="none"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="3600000"
    android:widgetCategory="home_screen" />
